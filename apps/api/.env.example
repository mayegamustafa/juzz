# Postgres (matches docker-compose; host port 5433)
DATABASE_URL="postgresql://qpms:qpms_dev_password@localhost:5433/qpms?schema=public"

# Server
PORT=4010
CORS_ORIGIN="http://localhost:3000"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret-dev"
JWT_REFRESH_SECRET="change-me-refresh-secret-dev"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# First-run setup (web: /setup). Only set this while bootstrapping a brand new,
# empty database. The endpoint refuses to run once any user exists, and refuses
# entirely if this is unset. Safe to remove after the first admin is created;
# leaving it set is also safe, since it becomes inert once a user exists.
SETUP_KEY="change-me-setup-key"
